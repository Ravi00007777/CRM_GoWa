# Express app
PORT=8080

# AlmaEd's Supabase Postgres. Teachers, students and batches are read from here and the
# relayed-message log is written back; admin edits everything on the AlmaEd site.
# Use the same pooled connection string AlmaEd uses (port 6543).
DATABASE_URL=postgresql://postgres:password@host:6543/postgres?pgbouncer=true

# gowa
GOWA_BASE_URL=http://localhost:3000
GOWA_BASIC_AUTH=admin:change-me
TEACHER_DEVICE_ID=teacher
STUDENT_DEVICE_ID=student
WEBHOOK_SECRET=change-me-long-random-string

# Admin
ADMIN_WA_JID=919876543210@s.whatsapp.net
ADMIN_TOKEN=change-me-another-long-random-string

DEFAULT_COUNTRY_CODE=91

